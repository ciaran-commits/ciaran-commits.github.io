---
layout: base.njk
---
<article class="project wrap">
  <header class="project-head">
    <h1 class="project-title">{{ title }}</h1>
    {%- if summary %}
    <p class="project-summary">{{ summary }}</p>
    {%- endif %}
    <dl class="project-specs">
      {%- if client %}<div><dt>Client</dt><dd>{{ client }}</dd></div>{% endif %}
      {%- if timeline %}<div><dt>Timeline</dt><dd>{{ timeline }}</dd></div>
      {%- elif year %}<div><dt>Year</dt><dd>{{ year }}</dd></div>{% endif %}
      {%- if role %}<div><dt>Role</dt><dd>{{ role }}</dd></div>{% endif %}
      {%- if tools %}<div><dt>Tools</dt><dd>{{ tools }}</dd></div>{% endif %}
      {%- if outcome %}<div><dt>Outcome</dt><dd>{{ outcome }}</dd></div>{% endif %}
    </dl>
  </header>

  <div class="project-cover">
    {{ heroSrc | coverImage(title) | safe }}
  </div>

  <div class="prose">
    {{ content | safe }}
    {#- No photos placed in the text? Show everything in the images folder. #}
    {%- if not (content | hasMedia) %}
    {{ page.inputPath | folderGallery(heroSrc) | safe }}
    {%- endif %}
  </div>

  {%- set next = collections.projects | nextProject(page.url) %}
  {%- if next %}
  <a class="next-project" href="{{ next.url }}">
    <span class="next-project-label">Next project</span>
    <span class="next-project-title">{{ next.data.title }} <span aria-hidden="true">→</span></span>
  </a>
  {%- endif %}
</article>
